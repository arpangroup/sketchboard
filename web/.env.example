# WebSocket URL of the collaboration relay (defaults to ws://<current-host>:3002)
VITE_COLLAB_SERVER_URL=ws://localhost:3002

# HTTP URL of the workspace API (defaults to the collaboration server's host on port 3002)
# VITE_API_URL=http://localhost:3002

# Static hosting without a server (GitHub Pages): server features show an explanation instead
# VITE_NO_SERVER=true

# Sub-folder builds: npm run build -- --base=/sketchboard/
